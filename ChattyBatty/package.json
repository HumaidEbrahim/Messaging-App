{
  "name": "chattybatty",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-firebase.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-chattybatty \"vitest run tests\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-chattybatty",
    "dev:emulators": "vite --mode emulator",
    "seed": "node scripts/seed-emulator.js"
  },
  "dependencies": {
    "@fontsource-variable/gabarito": "^5.3.0",
    "@tailwindcss/vite": "^4.1.4",
    "dayjs": "^1.11.13",
    "emoji-picker-react": "^4.12.2",
    "firebase": "^11.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-firebase-hooks": "^5.1.1",
    "react-icons": "^5.5.0",
    "react-textarea-autosize": "^8.5.9",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "daisyui": "^5.0.28",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^14.27.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "vite": "^6.3.1",
    "vitest": "^3.2.7"
  }
}
