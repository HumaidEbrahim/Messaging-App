# Used by `npm run dev:emulators`. Points the app at the local Firebase
# emulators, so no real project or credentials are needed.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-chattybatty.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-chattybatty
VITE_FIREBASE_APP_ID=demo-app
